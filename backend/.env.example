# LLM — LiteLLM 统一路由，默认 DeepSeek
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key
# 可选：覆盖 provider 预设 api_base
# LLM_BASE_URL=https://api.deepseek.com

# 可选：按角色指定 LiteLLM model id；不填则使用 provider 预设
# COORDINATOR_MODEL=deepseek/deepseek-chat
# WORKER_MODEL=deepseek/deepseek-chat
# LLM_TEMPERATURE=0.2

# 闸门 LLM 分类置信度阈值（建议 0.5–0.95，默认 0.75）
# GATE_LLM_ACCEPT_THRESHOLD=0.75

# 切换 OpenAI 示例：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# COORDINATOR_MODEL=gpt-4o-mini

# 自建 OpenAI 兼容网关：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://gateway.example/v1
# COORDINATOR_MODEL=gpt-4o-mini

# 数据目录由 make dev <suffix> 决定（./data/{suffix}），无需额外配置文件。
# 市场调研默认：每个 BOSS 关键词最多保留 30 个有效岗位，单方向总预算 10 分钟。
# 本地快速测试可改为 2 和 60；使用双下划线覆盖嵌套 market_research（市场调研）配置。
MARKET_RESEARCH__TARGET_JOBS_PER_KEYWORD=30
MARKET_RESEARCH__BUDGET_SECONDS=600
# 临时跳过 Google Trends 页面采集；恢复采集时改为 true。
MARKET_RESEARCH__TRENDS_ENABLED=false
