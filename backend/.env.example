# LLM — LiteLLM 统一路由，默认 DeepSeek
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key
# 可选：覆盖 provider 预设 api_base
# LLM_BASE_URL=https://api.deepseek.com

# 可选：按角色指定 LiteLLM model id；不填则使用 provider 预设
# COORDINATOR_MODEL=deepseek/deepseek-chat
# WORKER_MODEL=deepseek/deepseek-chat
# LLM_TEMPERATURE=0.2

# 切换 OpenAI 示例：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# COORDINATOR_MODEL=gpt-4o-mini

# 自建 OpenAI 兼容网关：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://gateway.example/v1
# COORDINATOR_MODEL=gpt-4o-mini

# 数据目录（默认 ./data、./output）。同机隔离请用专用 env 文件 + make dev-demo / dev-test：
#   backend/.env.demo  → DATA_DIR=./data/demo
#   backend/.env.test  → DATA_DIR=./data/test
# LLM 配置仍放在本文件 backend/.env；启动时会与 .env.demo / .env.test 合并加载。
